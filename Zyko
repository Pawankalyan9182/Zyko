  ShoppingBag, Search, MapPin, Clock, Plus, Minus, 
  ArrowLeft, Bike, CheckCircle2, Home, User, Receipt, 
  Zap, Package, Navigation, ChevronRight, ShieldCheck
} from 'lucide-react';

// --- MOCK DATA ---
const CATEGORIES = ["All", "Fruits", "Dairy", "Snacks", "Beverages", "Bakery"];

const PRODUCTS = [
  { id: 1, name: "Farm Fresh Apples", price: 3.99, weight: "1 kg", icon: "🍎", category: "Fruits" },
  { id: 2, name: "Whole Milk 1L", price: 2.49, weight: "1 L", icon: "🥛", category: "Dairy" },
  { id: 3, name: "Spicy Potato Chips", price: 1.99, weight: "150 g", icon: "🥔", category: "Snacks" },
  { id: 4, name: "Cola 6-Pack", price: 4.99, weight: "6 x 330ml", icon: "🥤", category: "Beverages" },
  { id: 5, name: "Ripe Bananas", price: 1.49, weight: "6 pcs", icon: "🍌", category: "Fruits" },
  { id: 6, name: "Free Range Eggs", price: 3.49, weight: "12 pack", icon: "🥚", category: "Dairy" },
  { id: 7, name: "Dark Chocolate", price: 1.29, weight: "50 g", icon: "🍫", category: "Snacks" },
  { id: 8, name: "Orange Juice", price: 3.99, weight: "1 L", icon: "🧃", category: "Beverages" },
  { id: 9, name: "Sourdough Bread", price: 2.99, weight: "1 loaf", icon: "🍞", category: "Bakery" },
  { id: 10, name: "Hass Avocado", price: 1.99, weight: "1 pc", icon: "🥑", category: "Fruits" },
  { id: 11, name: "Butter Croissant", price: 2.49, weight: "2 pcs", icon: "🥐", category: "Bakery" },
  { id: 12, name: "Sparkling Water", price: 1.99, weight: "1 L", icon: "💧", category: "Beverages" },
];

export default function App() {
  const [view, setView] = useState('home'); // home, cart, tracking
  const [cart, setCart] = useState([]);
  const [activeCategory, setActiveCategory] = useState("All");
  
  // Cart Functions
  const addToCart = (product) => {
    setCart(prev => {
      const existing = prev.find(item => item.id === product.id);
      if (existing) {
        return prev.map(item => item.id === product.id ? { ...item, qty: item.qty + 1 } : item);
      }
      return [...prev, { ...product, qty: 1 }];
    });
  };

  const removeFromCart = (productId) => {
    setCart(prev => {
      const existing = prev.find(item => item.id === productId);
      if (existing.qty === 1) {
        return prev.filter(item => item.id !== productId);
      }
      return prev.map(item => item.id === productId ? { ...item, qty: item.qty - 1 } : item);
    });
  };

  const getCartTotal = () => cart.reduce((total, item) => total + (item.price * item.qty), 0);
  const getCartCount = () => cart.reduce((count, item) => count + item.qty, 0);
  const getProductQty = (productId) => cart.find(item => item.id === productId)?.qty || 0;

  const handleCheckout = () => {
    setView('tracking');
  };

  const filteredProducts = activeCategory === "All" 
    ? PRODUCTS 
    : PRODUCTS.filter(p => p.category === activeCategory);

  return (
    <div className="flex justify-center bg-gray-200 min-h-screen font-sans">
      {/* Mobile Device Simulator Container */}
      <div className="w-full max-w-md bg-gray-50 min-h-screen shadow-2xl relative overflow-hidden flex flex-col">
        
        {view === 'home' && (
          <HomeView 
            cartCount={getCartCount()} 
            cartTotal={getCartTotal()}
            onViewCart={() => setView('cart')}
            activeCategory={activeCategory}
            setActiveCategory={setActiveCategory}
            products={filteredProducts}
            getProductQty={getProductQty}
            addToCart={addToCart}
            removeFromCart={removeFromCart}
          />
        )}

        {view === 'cart' && (
          <CartView 
            cart={cart}
            total={getCartTotal()}
            onBack={() => setView('home')}
            onCheckout={handleCheckout}
            addToCart={addToCart}
            removeFromCart={removeFromCart}
          />
        )}

        {view === 'tracking' && (
          <TrackingView 
            onBack={() => {
              setView('home');
              setCart([]); // Clear cart on complete
            }} 
          />
        )}

      </div>
    </div>
  );
}

