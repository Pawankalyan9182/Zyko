function TrackingView({ onBack }) {
  const [timeLeft, setTimeLeft] = useState(600); // 10 mins = 600 seconds
  const [stage, setStage] = useState(1);

  // Timer countdown
  useEffect(() => {
    if (timeLeft <= 0) return;
    
    const timer = setInterval(() => {
      setTimeLeft(prev => {
        const newTime = prev - 1;
        // Update stage based on time
        if (newTime <= 0) setStage(4);
        else if (newTime <= 180) setStage(3); // Last 3 mins: Arriving
        else if (newTime <= 480) setStage(2); // After 2 mins: On the way
        return newTime;
      });
    }, 1000); // Set to 1000 for realistic, or e.g., 50 for fast simulation

    return () => clearInterval(timer);
  }, [timeLeft]);

  const mins = Math.floor(timeLeft / 60);
  const secs = timeLeft % 60;
  
  // Progress bar percentage (100% -> 0%)
  const progress = ((600 - timeLeft) / 600) * 100;

  return (
    <div className="flex flex-col h-full bg-gray-50 relative">
      
      {/* Map Background Placeholder */}
      <div className="absolute inset-0 z-0 bg-[#e5e3df] overflow-hidden">
        {/* Fake Map Roads */}
        <div className="absolute top-1/4 left-0 w-full h-8 bg-white/60 transform -rotate-12"></div>
        <div className="absolute top-1/3 right-10 w-8 h-full bg-white/60 transform rotate-12"></div>
        <div className="absolute top-1/2 left-0 w-full h-12 bg-white/80 flex items-center justify-center">
          <div className="w-full border-t-4 border-dashed border-indigo-400/50"></div>
        </div>
        
        {/* Moving Delivery Icon on map */}
        <div 
          className="absolute z-10 transition-all duration-1000 ease-linear flex flex-col items-center"
          style={{ 
            top: `${Math.max(20, 70 - (progress * 0.6))}%`, 
            left: `${Math.min(80, 20 + (progress * 0.8))}%` 
          }}
        >
          <div className="bg-indigo-600 text-white p-2 rounded-full shadow-lg border-2 border-white animate-bounce">
            <Bike size={20} />
          </div>
          <div className="w-4 h-1 bg-black/20 rounded-full mt-1 blur-sm"></div>
        </div>

        {/* Home Destination Pin */}
        <div className="absolute top-[20%] left-[80%] z-10 flex flex-col items-center">
          <div className="bg-green-500 text-white p-2 rounded-full shadow-lg border-2 border-white">
            <Home size={20} />
          </div>
        </div>
      </div>

      {/* Floating Header */}
      <div className="z-10 p-4">
        <button onClick={onBack} className="bg-white/90 backdrop-blur-sm p-3 rounded-full shadow-md hover:bg-gray-100 transition inline-flex items-center justify-center">
          <ArrowLeft size={20} className="text-gray-800" />
        </button>
      </div>

      {/* Spacer to push content down */}
      <div className="flex-1"></div>

      {/* Tracking Card - Bottom Sheet style */}
      <div className="bg-white z-10 rounded-t-3xl shadow-[0_-10px_40px_rgba(0,0,0,0.1)] p-6 pb-8 relative">
        {/* Drag Handle */}
        <div className="w-12 h-1.5 bg-gray-200 rounded-full mx-auto absolute top-3 left-1/2 -translate-x-1/2"></div>

        {timeLeft > 0 ? (
          <>
            <div className="text-center mb-6 mt-2">
              <h2 className="text-4xl font-black text-indigo-600 tracking-tighter tabular-nums flex items-center justify-center">
                {mins.toString().padStart(2, '0')}<span className="animate-pulse mx-1">:</span>{secs.toString().padStart(2, '0')}
              </h2>
              <p className="text-gray-500 font-medium uppercase tracking-widest text-xs mt-1">Estimated Delivery</p>
            </div>

            {/* Progress Bar */}
            <div className="w-full bg-gray-100 h-3 rounded-full overflow-hidden mb-8">
              <div 
                className="h-full bg-gradient-to-r from-indigo-500 to-purple-600 rounded-full transition-all duration-1000 ease-linear"
                style={{ width: `${progress}%` }}
              ></div>
            </div>

            {/* Status Steps */}
            <div className="space-y-6 relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-gray-200 before:to-transparent">
              
              <StatusStep 
                icon={<Package size={18} />} 
                title="Packing your order" 
                subtitle="Your items are being carefully packed"
                active={stage >= 1} 
                current={stage === 1}
              />
              <StatusStep 
                icon={<Bike size={18} />} 
                title="On the way" 
                subtitle="Rider has picked up your order"
                active={stage >= 2} 
                current={stage === 2}
              />
              <StatusStep 
                icon={<Navigation size={18} />} 
                title="Arriving soon" 
                subtitle="Rider is near your location"
                active={stage >= 3} 
                current={stage === 3}
              />
            </div>

            {/* Rider Info (shows when on the way) */}
            {stage >= 2 && (
              <div className="mt-8 pt-6 border-t border-gray-100 flex items-center justify-between">
                <div className="flex items-center">
                  <div className="w-12 h-12 bg-gray-200 rounded-full overflow-hidden border-2 border-indigo-100 flex justify-center items-end mr-3">
                     <User size={36} className="text-gray-400 -mb-2" />
                  </div>
                  <div>
                    <h4 className="font-bold text-gray-800">Alex M.</h4>
                    <p className="text-xs text-gray-500 flex items-center">
                      ⭐ 4.9 (1.2k+ deliveries)
                    </p>
                  </div>
                </div>
                <button className="bg-indigo-50 text-indigo-600 p-3 rounded-full hover:bg-indigo-100 transition">
                  Call Rider
                </button>
              </div>
            )}
          </>
        ) : (
          /* Delivered State */
          <div className="text-center py-6 mt-4 animate-fade-up">
            <div className="w-24 h-24 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
              <CheckCircle2 size={50} className="text-green-500" />
            </div>
            <h2 className="text-3xl font-bold text-gray-800 mb-2">Delivered!</h2>
            <p className="text-gray-500 mb-8">Your Zyko order has safely arrived. Enjoy!</p>
            <button 
              onClick={onBack}
              className="bg-indigo-600 text-white py-3 px-8 rounded-full font-bold shadow-lg w-full"
            >
              Back to Home
            </button>
          </div>
        )}
      </div>
    </div>
  );
}

function StatusStep({ icon, title, subtitle, active, current }) {
  return (
    <div className={`relative flex items-center ${active ? 'opacity-100' : 'opacity-40'}`}>
      <div className={`
        z-10 flex items-center justify-center w-10 h-10 rounded-full border-2 
        ${current ? 'bg-indigo-600 border-indigo-600 text-white shadow-lg shadow-indigo-200 animate-pulse' : 
          active ? 'bg-indigo-600 border-indigo-600 text-white' : 'bg-white border-gray-300 text-gray-400'}
      `}>
        {active && !current ? <CheckCircle2 size={18} /> : icon}
      </div>
      <div className="ml-4">
